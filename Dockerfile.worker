FROM python:3.13-slim

ARG ENGINE_COMMIT=unknown
ARG DATA_MANIFEST_HASH=unknown
ARG IMAGE_REF=unknown

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    KEEP_AND_LEASE_DATA_ROOT=/app \
    KEEP_AND_LEASE_ENGINE_COMMIT=${ENGINE_COMMIT} \
    KEEP_AND_LEASE_DATA_MANIFEST_HASH=${DATA_MANIFEST_HASH} \
    KEEP_AND_LEASE_IMAGE_REF=${IMAGE_REF}

WORKDIR /app
COPY requirements.txt requirements-cloud.txt ./
RUN pip install --no-cache-dir -r requirements-cloud.txt \
    && addgroup --system app \
    && adduser --system --ingroup app app

COPY VERSION ./
COPY backtest_silver_lease_strategy.py silver_strategy_gui.py maturity_scoring.py rate_change_attribution.py ./
COPY gold_silver.zip si.zip gc.zip cl.zip w.zip c.zip s.zip sp.zip DCOILWTICO.csv ./
COPY DGS1.csv DGS2.csv DGS3.csv DGS5.csv DTB3.csv DTB6.csv ./
COPY server ./server
COPY cloud_worker_main.py ./

USER app
CMD ["python", "cloud_worker_main.py"]

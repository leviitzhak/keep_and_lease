# Recovery base: the exact web runtime verified by the successful 2026-09-16
# preview rollout. Current application files are layered over these known-good
# Python and dependency bytes.
FROM me-west1-docker.pkg.dev/keep-and-lease/keep-and-lease/web@sha256:c683538a62ee2bbd9b76e685e2b77259230e536fda269a0a3c40438872c6d70e

ARG ENGINE_COMMIT=unknown
ARG DATA_MANIFEST_HASH=unknown
ARG IMAGE_REF=unknown

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    KEEP_AND_LEASE_JOB_BACKEND=cloud \
    KEEP_AND_LEASE_ENGINE_COMMIT=${ENGINE_COMMIT} \
    KEEP_AND_LEASE_DATA_MANIFEST_HASH=${DATA_MANIFEST_HASH} \
    KEEP_AND_LEASE_IMAGE_REF=${IMAGE_REF}

WORKDIR /app
COPY --chown=app:app VERSION ./
COPY --chown=app:app backtest_silver_lease_strategy.py silver_strategy_gui.py maturity_scoring.py rate_change_attribution.py market_data_store.py observed_execution.py backtest_audit.py btc_trade_backtest.py trade_replay.py funded_ledger.py paired_transfer.py paired_transfer_economics.py paired_amortized_strategy.py paired_transfer_rates.py paired_execution_study.py trade_data_store.py trade_ordering.py replay_checkpoints.py ./
COPY --chown=app:app server ./server
COPY --chown=app:app server_main.py ./
COPY --chown=app:app strategies ./strategies
COPY --chown=app:app public/silver_strategy_gui.html public/backtest-runs.js public/shared-run-plots.js public/backtest-worker-v13.js public/backtest-workbook-v1.js public/fflate.js ./public/

USER app
EXPOSE 8080
CMD ["python", "-m", "uvicorn", "server_main:app", "--host", "0.0.0.0", "--port", "8080"]

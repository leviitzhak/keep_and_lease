FROM python:3.13-slim

ARG ENGINE_COMMIT=unknown
ARG DATA_MANIFEST_HASH=unknown
ARG IMAGE_REF=unknown

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    KEEP_AND_LEASE_JOB_BACKEND=cloud \
    KEEP_AND_LEASE_ENGINE_COMMIT=${ENGINE_COMMIT} \
    KEEP_AND_LEASE_DATA_MANIFEST_HASH=${DATA_MANIFEST_HASH} \
    KEEP_AND_LEASE_IMAGE_REF=${IMAGE_REF}

WORKDIR /app
COPY requirements.txt requirements-cloud.txt ./
RUN pip install --no-cache-dir -r requirements-cloud.txt \
    && addgroup --system app \
    && adduser --system --ingroup app app

COPY VERSION ./
COPY backtest_silver_lease_strategy.py silver_strategy_gui.py maturity_scoring.py rate_change_attribution.py market_data_store.py ./
COPY server ./server
COPY server_main.py ./
COPY public/silver_strategy_gui.html public/backtest-worker-v13.js ./public/

USER app
EXPOSE 8080
CMD ["python", "server_main.py"]

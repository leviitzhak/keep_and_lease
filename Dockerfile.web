# Keep Cloud Run on the base image verified by the successful 2026-09-16 rollout.
FROM python:3.13-slim@sha256:9d2e5553305c7c7b0097999bb17187c69b921ccd6bc9d40e4bb5ebe652c00285

ARG ENGINE_COMMIT=unknown
ARG DATA_MANIFEST_HASH=unknown
ARG IMAGE_REF=unknown

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    KEEP_AND_LEASE_JOB_BACKEND=cloud \
    KEEP_AND_LEASE_ENGINE_COMMIT=${ENGINE_COMMIT} \
    KEEP_AND_LEASE_DATA_MANIFEST_HASH=${DATA_MANIFEST_HASH} \
    KEEP_AND_LEASE_IMAGE_REF=${IMAGE_REF}

WORKDIR /app
COPY requirements.txt requirements-cloud.txt ./
RUN pip install --no-cache-dir -r requirements-cloud.txt \
    && addgroup --system app \
    && adduser --system --ingroup app app

COPY VERSION ./
COPY backtest_silver_lease_strategy.py silver_strategy_gui.py maturity_scoring.py rate_change_attribution.py market_data_store.py observed_execution.py backtest_audit.py btc_trade_backtest.py trade_replay.py funded_ledger.py paired_transfer.py paired_transfer_economics.py paired_amortized_strategy.py paired_transfer_rates.py paired_execution_study.py trade_data_store.py trade_ordering.py replay_checkpoints.py ./
COPY server ./server
COPY server_main.py ./
COPY strategies ./strategies
COPY public/silver_strategy_gui.html public/backtest-runs.js public/shared-run-plots.js public/backtest-worker-v13.js public/backtest-workbook-v1.js public/fflate.js ./public/

USER app
EXPOSE 8080
CMD ["python", "server_main.py"]
